# ────────────────────────────────────────────────────────────────────────────
# MonJoël — Variables d'environnement (template public)
# Copier en .env.local pour le dev, et configurer côté Vercel pour la prod.
# Les valeurs sensibles (tokens, secrets) NE DOIVENT PAS être commitées.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth + données) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Back-office /admin : allowlist d'emails admin ───────────────────────────
# Liste d'emails (séparés par des virgules) autorisés à accéder à /admin et
# /api/admin. Vérifiée CÔTÉ SERVEUR par le proxy (middleware) + les route
# handlers. NON préfixée NEXT_PUBLIC_ → jamais exposée dans le bundle client.
# fail-closed : si vide/absente, AUCUN accès admin n'est accordé.
# Exemple : ADMIN_ALLOWED_EMAILS="contact@monjoel.fr,admin@monjoel.fr"
ADMIN_ALLOWED_EMAILS=

# ── Google Ads — conversion devis (R9) ─────────────────────────────────────
# Label de conversion "devis envoyé" au format AW-XXXXXXXXX/xxxxxxxxxxxxx.
# À récupérer dans Google Ads > Objectifs > Conversions > (action) > balise
# → champ "send_to". Laissé vide = aucune conversion gtag directe n'est émise
# (GTM écoute déjà l'event dataLayer `quote_form_success`).
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# ── Resend (emails transactionnels) ────────────────────────────────────────
RESEND_API_KEY=
# Expéditeur vérifié (sinon fallback onboarding@resend.dev). Ex: "Joël <contact@monjoel.fr>"
RESEND_FROM_EMAIL=

# ── Notifications dispatch artisan — WhatsApp Business (optionnel) ──────────
# Permet de notifier l'artisan par WhatsApp à l'assignation d'une mission.
# Sans ça, l'artisan est notifié par EMAIL uniquement (Resend). CallMeBot n'est
# PAS utilisé pour le dispatch (il n'écrit qu'à un numéro pré-enregistré = équipe).
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_ID=

# ── Sentry (monitoring erreurs + performance) ──────────────────────────────
# Active automatiquement le wrapper si DSN + AUTH_TOKEN sont définis.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set à 1 pour activer Sentry en dev (sinon désactivé pour pas polluer le quota)
SENTRY_DEBUG=
NEXT_PUBLIC_SENTRY_DEBUG=

# ── Google Analytics / Tag Manager ─────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ── Google Search Console (verification) ───────────────────────────────────
# Code de vérification site GSC (à injecter dans app/page.tsx metadata.verification.google)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Google Search Console API (dashboard /admin/seo) ───────────────────────
# Service account GCP qui a accès en lecture à Search Console.
# Setup détaillé : voir docs/admin-seo-setup.md
#
# Option A (recommandé en prod) : JSON entier stringifié
# (échapper les retours-chariot avec \n dans la private_key)
GSC_SERVICE_ACCOUNT_KEY=
# Option B (dev local) : path absolu vers le .json téléchargé depuis GCP
GSC_SERVICE_ACCOUNT_KEY_FILE=
# URL du site dans Search Console. Format domain property = "sc-domain:monjoel.fr"
# Format URL prefix = "https://monjoel.fr/"
GSC_SITE_URL=sc-domain:monjoel.fr
# Secret pour le cron auto Vercel (générer un long string random)
CRON_SECRET=
# Fallback header X-Admin-Key pour curl/debug du sync manuel (optionnel)
ADMIN_API_KEY=

# ── Cookiebot (RGPD) ───────────────────────────────────────────────────────
NEXT_PUBLIC_COOKIEBOT_CBID=

# ── Lighthouse CI (uniquement nécessaire pour upload temporaire) ───────────
# Pas d'auth requise pour le mode "temporary-public-storage" par défaut.
LHCI_GITHUB_APP_TOKEN=
