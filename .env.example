# ────────────────────────────────────────────────────────────────────────────
# MonJoël — Variables d'environnement (template public)
# Copier en .env.local pour le dev, et configurer côté Vercel pour la prod.
# Les valeurs sensibles (tokens, secrets) NE DOIVENT PAS être commitées.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth + données) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (emails transactionnels) ────────────────────────────────────────
RESEND_API_KEY=

# ── Sentry (monitoring erreurs + performance) ──────────────────────────────
# Active automatiquement le wrapper si DSN + AUTH_TOKEN sont définis.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set à 1 pour activer Sentry en dev (sinon désactivé pour pas polluer le quota)
SENTRY_DEBUG=
NEXT_PUBLIC_SENTRY_DEBUG=

# ── Google Analytics / Tag Manager ─────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ── Google Search Console (verification) ───────────────────────────────────
# Code de vérification site GSC (à injecter dans app/page.tsx metadata.verification.google)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Cookiebot (RGPD) ───────────────────────────────────────────────────────
NEXT_PUBLIC_COOKIEBOT_CBID=

# ── Lighthouse CI (uniquement nécessaire pour upload temporaire) ───────────
# Pas d'auth requise pour le mode "temporary-public-storage" par défaut.
LHCI_GITHUB_APP_TOKEN=
